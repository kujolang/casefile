test "list and show latest commands work" {
	kujo_bin := "/Users/robertdevore/2026/kujo/target/debug/kujo"
	casefile_script := "/Users/robertdevore/Documents/Kujolang/kujo-repos/casefile/casefile.kujo"
	ws := "/tmp/casefile-test-listshow-" + to_string(current_timestamp())
	spawn_process(["rm", "-rf", ws])
	spawn_process(["mkdir", "-p", ws])

	prev := os_getcwd()
	os_chdir(ws)
	spawn_process([kujo_bin, "run", "--interpreter", casefile_script, "--", "init"])
	spawn_process([kujo_bin, "run", "--interpreter", casefile_script, "--", "capture", "--manual", "--name", "alpha"])
	list_res := spawn_process([kujo_bin, "run", "--interpreter", casefile_script, "--", "list"])
	show_res := spawn_process([kujo_bin, "run", "--interpreter", casefile_script, "--", "show", "latest", "--format", "json"])
	os_chdir(prev)

	assert_equal(to_int(list_res.exitcode), 0)
	assert_true(index_of(to_string(list_res.stdout), "Case ID | Name | Exit | Severity | Path") >= 0)
	assert_equal(to_int(show_res.exitcode), 0)
	shown := parse_json(to_string(show_res.stdout))
	assert_true(type(shown["case"]) == "dict")
}

test "clean dry-run reports deletions" {
	kujo_bin := "/Users/robertdevore/2026/kujo/target/debug/kujo"
	casefile_script := "/Users/robertdevore/Documents/Kujolang/kujo-repos/casefile/casefile.kujo"
	ws := "/tmp/casefile-test-clean-" + to_string(current_timestamp())
	spawn_process(["rm", "-rf", ws])
	spawn_process(["mkdir", "-p", ws])

	prev := os_getcwd()
	os_chdir(ws)
	spawn_process([kujo_bin, "run", "--interpreter", casefile_script, "--", "init"])
	spawn_process([kujo_bin, "run", "--interpreter", casefile_script, "--", "capture", "--manual", "--name", "one"])
	spawn_process([kujo_bin, "run", "--interpreter", casefile_script, "--", "capture", "--manual", "--name", "two"])
	spawn_process([kujo_bin, "run", "--interpreter", casefile_script, "--", "capture", "--manual", "--name", "three"])
	clean_res := spawn_process([kujo_bin, "run", "--interpreter", casefile_script, "--", "clean", "--keep", "1", "--dry-run"])
	os_chdir(prev)

	assert_equal(to_int(clean_res.exitcode), 0)
	assert_true(index_of(to_string(clean_res.stdout), "[dry-run] would delete") >= 0)
}
