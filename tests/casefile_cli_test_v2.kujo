	spawn_process(["mkdir", "-p", ws])

	prev := os_getcwd()
	os_chdir(ws)
	spawn_process([kujo_bin, "run", "--interpreter", casefile_script, "--", "init"])
	res := spawn_process([kujo_bin, "run", "--interpreter", casefile_script, "--", "capture", "--name", "mirror", "--mirror-exit-code", "--", "false"])
