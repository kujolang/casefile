{
  "name": "casefile-launch-readiness",
  "version": "0.1.0",
  "tests": [
    {
      "name": "CaseFile help succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "kujo run --interpreter casefile.kujo -- help"
      }
    },
    {
      "name": "CaseFile test suite succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "KUJO_BIN=kujo kujo test-run -v tests/casefile_cli_test_v2.kujo"
      }
    },
    {
      "name": "CaseFile unsupported version flag exits 2",
      "check": "exit_code_equals",
      "params": {
        "command": "kujo run --interpreter casefile.kujo -- --version",
        "expected": 2
      }
    },
    {
      "name": "CaseFile hardening regressions succeed",
      "check": "command_succeeds",
      "params": {
        "command": "python3 -m unittest discover -s tests -p 'test_hardening.py'"
      }
    }
  ]
}
